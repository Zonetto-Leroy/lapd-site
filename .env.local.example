# Copie ce fichier en ".env.local" et remplis les valeurs (ne jamais commit .env.local)

# Discord Developer Portal > ton appli > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Token du bot Discord invité sur le serveur LAPD
DISCORD_BOT_TOKEN=

# ID du serveur Discord LAPD
DISCORD_GUILD_ID=

# À ajouter tel quel dans Discord Developer Portal > OAuth2 > Redirects
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Chaîne aléatoire longue, pour signer les cookies de session
SESSION_SECRET=

# Lien d'invitation Discord public
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ID du rôle Discord donnant accès à /membres (candidat accepté)
LAPD_MEMBER_ROLE_ID=

# Salon Discord où atterrissent les candidatures soumises depuis /candidater
RECRUITMENT_APPLICATIONS_CHANNEL_ID=
