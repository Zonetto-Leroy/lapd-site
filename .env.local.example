# Copie ce fichier en ".env.local" et remplis les valeurs (ne jamais commit .env.local)

# Chaîne aléatoire longue, pour signer les cookies de session
SESSION_SECRET=

# Base Redis (Upstash via Vercel Marketplace) — comptes, candidatures, effectif
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Code secret à saisir à l'inscription pour créer un compte staff (garde-le confidentiel,
# ne le partage qu'aux membres de confiance)
STAFF_SIGNUP_KEY=
